# copy to .env and fill in. .env never goes into git.

# languages every agent may speak, comma separated. the first one opens a video call
LANGUAGES=en,de,es,ru,hi

# google cloud
GCP_PROJECT=your-project-id
GCP_REGION=europe-west3
CLOUD_RUN_SERVICE=tib-chat
PAGE_BUCKET=your-private-bucket

# passwords. the team password opens the app, the admin password opens /dashboard
DEMO_PASSWORD=
ADMIN_PASSWORD=

# the llm for luna, guido and the live boards. any openai compatible api.
# recommended: gemini 3.5 flash-lite through google's openai endpoint (key from aistudio.google.com)
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-3.5-flash-lite
LLM_REASONING_EFFORT=low
LLM_FALLBACK_MODEL=gemini-3.1-flash-lite
LLM_API_KEY=
# or Vertex AI, billed to the Cloud billing account, auth by the Cloud Run service account (needs roles/aiplatform.user):
# LLM_API_KEY=vertex
# LLM_BASE_URL=https://aiplatform.googleapis.com/v1/projects/<project>/locations/global/endpoints/openapi
# LLM_MODEL=google/gemini-3.5-flash-lite
# LLM_FALLBACK_MODEL=google/gemini-3.1-flash-lite

# lino on modal. pick any long random LINO_API_KEY, the same in every workspace. one token per modal workspace:
# the first in MODAL_TOKEN_ID/SECRET, more as id:secret, comma separated, in MODAL_EXTRA_TOKENS (deploy/deploy_new_modal.py adds them)
LINO_API_KEY=
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
MODAL_EXTRA_TOKENS=

# tavus video calls
# one key per tavus account. more accounts: comma separated in TAVUS_EXTRA_KEYS, then python tavus/sync.py
# plan minutes and renewal day per account: app/data/tavus_accounts.json
TAVUS_API_KEY=
TAVUS_EXTRA_KEYS=
MAX_CALL_SECONDS=300

# cloudflare workers ai, clef-flash directs guido's shared screen. optional
CF_ACCOUNT_ID=
CF_API_TOKEN=
